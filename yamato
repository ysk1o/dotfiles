#!/bin/bash
set -euo pipefail

ascii_art='
 ___ ___   _______   _______   _______   _______   _______
|   |   | |   _   | |   |   | |   _   | |_     _| |       |
 \     /  |       | |       | |       |   |   |   |   -   |
  |___|   |___|___| |__|_|__| |___|___|   |___|   |_______|
'
echo "$ascii_art"

DOTFILES_PATH="$HOME/.local/share/dotfiles"

# Load library functions
source "$DOTFILES_PATH/lib/log.sh"
source "$DOTFILES_PATH/lib/args.sh"
source "$DOTFILES_PATH/lib/run.sh"
source "$DOTFILES_PATH/lib/fs.sh"
source "$DOTFILES_PATH/lib/brew.sh"

# Load boot functions
for bootfile in "$DOTFILES_PATH/boot/"*.sh; do
  [ -f "$bootfile" ] && source "$bootfile"
done

# Run boot sequence
check_version
fetch_repo

init_config
run_install
install_command
install_schedule

echo ""
echo "========================================================"
echo ""
echo "🔄 Please log out and log back in to apply all changes."
echo ""
echo "👉 Shortcut: Command (⌘) + Shift (⇧) + Q"
echo ""
echo "========================================================"
echo ""
